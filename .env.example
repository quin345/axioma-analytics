# --- Production data source (Fabric KQL / Eventhouse) ---------------------
# One source. Every table the dashboard reads lives in this KQL database:
#   dom_stream_raw / dom_book_flat  raw + flattened DOM feed (ingested, not read)
#   agg_dom                         derived per-tick order-book metrics
#   symbols_icmarkets               icmarkets instrument dimension
KQL_ENDPOINT_PROD="https://<eventhouse>.z<region>.kusto.fabric.microsoft.com"
KQL_DATABASE="ctrader_dom"
KQL_TABLE="agg_dom"
SYMBOL_TABLE="symbols_icmarkets"

# Buffer applied to the time filter so a tick written just before the window
# opens is still returned.
KQL_LAG_MINUTES="2"

# --- Redis cache ----------------------------------------------------------
# KQL results are cached here so a dashboard request never re-scans agg_dom.
# Entra ID only: there is no access key. The same identity that authenticates
# KQL mints the token for the https://redis.azure.com/ scope, and Redis
# Enterprise decides which keys it can touch. If the cache is unreachable the
# app still works - every request just costs a KQL query.
REDIS_HOST="<name>.<region>.redis.azure.net"
REDIS_PORT="10000"
REDIS_SSL="true"
REDIS_DB="0"
REDIS_TIMEOUT="15"
REDIS_KEY_PREFIX="axioma"

# Lifetime of a cached KQL result. 450 s (7.5 min) covers 1.5 refresh
# cycles, so one missed cycle still leaves the cache populated.
REDIS_TTL_SECONDS="450"

# The fixed window the cache holds. The UI may narrow it, never widen it. Eight
# hours is what the point-in-time controls need: the dashboard's timeline spans
# four hours (TIMELINE_MINUTES) and the aggregate window at any point on it may
# be up to 240 minutes (WINDOW_MAX_MINUTES), so the earliest point taken back by
# the widest window reaches exactly 4 h + 4 h.
CACHE_LOOKBACK_HOURS="8"

# The point-in-time controls. The timeline the user picks a moment from is
# TIMELINE_MINUTES long in TIMELINE_STEP_MINUTES steps (four hours in
# five-minute steps), and at each of its points an aggregate window is chosen
# from the fixed set WINDOW_CHOICES_MINUTES (1 h / 2 h / 3 h / 4 h). These
# mirror the four trailing windows the precomputed `metrics_5m` KQL table ships
# for every (symbolId, as_of) stop, so the control offers only what the table
# always precomputes. The widest window plus the timeline is what fixes
# CACHE_LOOKBACK_HOURS; choices wider than the cache are dropped, so a shorter
# cache narrows the control rather than offering history it cannot serve.
TIMELINE_MINUTES="240"
TIMELINE_STEP_MINUTES="5"
WINDOW_CHOICES_MINUTES="60,120,180,240"

# How often the background cycle slides the cached window on the clock (1-min
# marks plus a 15 s offset - :00:15, :01:15, ... - regardless of when the
# service started). The offset lets the upstream feed settle past the mark so
# the read never races immature data. Each cycle purges the earliest interval
# (the rows that aged past CACHE_LOOKBACK_HOURS) and reads only the newest
# interval from KQL, so the dashboard is never more than a minute behind
# the feed and an entry never holds more than eight hours per symbol. It runs
# inside the app process (the deployment is a single uvicorn worker) and
# refreshes immediately on start, which warms the cache after a restart. Keep
# REDIS_TTL_SECONDS above this: 450 s is many cycles, so a missed cycle still
# leaves the cache populated.
# 0 turns the cycle off and the window is cached lazily, on demand.
CACHE_REFRESH_MINUTES="1"
CACHE_REFRESH_OFFSET_SECONDS="15"

# --- Authentication ------------------------------------------------------
# Prefer the machine's managed identity on Azure hosts: the Kusto client and
# the Redis client both mint and refresh their own tokens, so there is no
# secret to store or rotate and no `az login` session for a background service
# to lose. The identity needs a Fabric workspace role (see "Granting access"
# below) plus read access to the KQL database, and Redis Data Contributor on
# the cache.
#
#   FABRIC_MANAGED_IDENTITY="true"                          # system-assigned
#   FABRIC_MANAGED_IDENTITY_CLIENT_ID="<client-id>"          # user-assigned
FABRIC_MANAGED_IDENTITY="true"
FABRIC_MANAGED_IDENTITY_CLIENT_ID=""

# Alternative: an Entra ID service principal with a client secret. Ignored
# while FABRIC_MANAGED_IDENTITY is on, which is why managed identity takes
# precedence - a leftover secret must not silently change the auth path.
# FABRIC_TENANT_ID="<tenant-guid>"
# FABRIC_CLIENT_ID="<app-registration-client-id>"
# FABRIC_CLIENT_SECRET="<client-secret>"

# --- Dashboard login ------------------------------------------------------
# One account gates the website itself: the dashboard at / and every /api/*
# endpoint that serves data redirect to /login without a session. This is
# user-facing and separate from the Entra identity above, which only
# authenticates the data plane. The gate exists ONLY while LOGIN_PASSWORD is
# set - blank leaves the site open (that is how the test suite runs), and
# run.py prints the state at startup so an open door is visible, not silent.
LOGIN_USERNAME="admin"
LOGIN_PASSWORD=""                  # set a strong password; .env is git-ignored
LOGIN_SESSION_HOURS="12"           # sessions live in the process; a restart signs everyone out
LOGIN_COOKIE_SECURE="false"        # "true" behind nginx/TLS so the cookie never rides plain HTTP

# Cap on rows fetched per request.
MAX_TICKS="200000"

# Ticker pinned as the dashboard default (matched by symbolName, then id).
DEFAULT_SYMBOL="XAUUSD"

# IANA zone every wall-clock time on the dashboard is rendered in - the clock,
# the time badges, the point-in-time field and the hourly profile. The data is
# stored and served in UTC; this only changes the lens it is shown through, and
# is published to the browser by /api/health.
DISPLAY_TIMEZONE="America/New_York"

# --- Availability ---------------------------------------------------------
# The main page (/) serves the dashboard (app/static/index.html). This flag keeps
# its original meaning: MAINTENANCE_MODE=1 serves the branded "temporarily
# unavailable" page (app/static/maintenance.html) from / instead, with a 503,
# for a real outage. Leave it off in normal operation; the outage page is always
# previewable at /unavailable either way.
MAINTENANCE_MODE="false"

