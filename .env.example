# --- Production SQL analytics endpoint (Fabric) -------------------------
# The app reads exactly one source: [ctrader_lakehouse].[gold].
SQL_ENDPOINT_PROD="<prod-endpoint>.datawarehouse.fabric.microsoft.com"

# Microsoft Entra ID service principal used to authenticate to the endpoint.
FABRIC_TENANT_ID="<tenant-guid>"
FABRIC_CLIENT_ID="<app-registration-client-id>"
FABRIC_CLIENT_SECRET="<client-secret>"

# Gold objects. Physical names are resolved server-side and never sent to the
# browser; they are configurable only so the app can follow a renamed table.
GOLD_DATABASE="ctrader_lakehouse"
GOLD_SCHEMA="gold"
SNAPSHOT_TABLE="agg_dom_book_snapshot"

# The icmarkets instrument dimension, joined to symbols_category_icmarkets
# and asset_classes_icmarkets to resolve the asset class.
SYMBOL_TABLE="symbols_icmarkets"

# Cap on rows fetched per request.
MAX_TICKS="200000"
