# --- SQL analytics endpoints (Fabric) -------------------------------------
# One entry per environment. Names are free-form; dev/test/prod are shown
# first in the dashboard selector. Pick the active one with SQL_ENV, the
# dashboard dropdown, or `python run.py --env <name>`. Blank entries are ignored.
SQL_ENV="test"
SQL_ENDPOINT_DEV="<dev-endpoint>.datawarehouse.fabric.microsoft.com"
SQL_ENDPOINT_TEST="<test-endpoint>.datawarehouse.fabric.microsoft.com"
SQL_ENDPOINT_PROD="<prod-endpoint>.datawarehouse.fabric.microsoft.com"

# Legacy single-endpoint form also works (exposed as the "default" environment).
# SQL_ANALYTICS_ENDPOINT="<host>.datawarehouse.fabric.microsoft.com"

# Microsoft Entra ID service principal used to authenticate to the endpoint.
FABRIC_TENANT_ID="<tenant-guid>"
FABRIC_CLIENT_ID="<app-registration-client-id>"
FABRIC_CLIENT_SECRET="<client-secret>"

# Optional: pin the tick table. Leave blank to auto-discover by column signature.
FABRIC_TICK_SCHEMA=
FABRIC_TICK_TABLE=

# Serve synthetic ticks when the endpoint is unreachable; cap rows fetched.
FABRIC_ALLOW_SYNTHETIC="true"
MAX_TICKS="200000"
