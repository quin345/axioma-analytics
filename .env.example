# --- Production endpoints (Fabric) ---------------------------------------
# Two sources: the per-tick aggregate DOM rows in the KQL (Eventhouse)
# database, and the instrument dimension on the SQL analytics endpoint.
KQL_ENDPOINT_PROD="https://<eventhouse>.z<region>.kusto.fabric.microsoft.com"
KQL_DATABASE="ctrader_dom"
KQL_TABLE="agg_dom"

SQL_ENDPOINT_PROD="<prod-endpoint>.datawarehouse.fabric.microsoft.com"

# --- Authentication ------------------------------------------------------
# Prefer the machine's managed identity on Azure hosts: both the ODBC driver
# and the Kusto client mint and refresh their own tokens, so there is no secret
# to store or rotate and no `az login` session for a background service to
# lose. The identity needs a workspace role (see "Granting access" below) plus
# read access to the KQL database; Contributor covers both.
#
#   FABRIC_MANAGED_IDENTITY="true"                          # system-assigned
#   FABRIC_MANAGED_IDENTITY_CLIENT_ID="<client-id>"          # user-assigned
FABRIC_MANAGED_IDENTITY="true"
FABRIC_MANAGED_IDENTITY_CLIENT_ID=""

# Alternative: an Entra ID service principal with a client secret. Ignored
# while FABRIC_MANAGED_IDENTITY is on, which is why managed identity takes
# precedence - a leftover secret must not silently change the auth path.
# FABRIC_TENANT_ID="<tenant-guid>"
# FABRIC_CLIENT_ID="<app-registration-client-id>"
# FABRIC_CLIENT_SECRET="<client-secret>"

# The Microsoft ODBC driver for SQL Server. Driver 17 or 18 both work.
FABRIC_ODBC_DRIVER="ODBC Driver 18 for SQL Server"

# Gold objects on the SQL analytics endpoint. Physical names are resolved
# server-side and never sent to the browser; they are configurable only so the
# app can follow a renamed table. Only the instrument dimension stays here.
GOLD_DATABASE="ctrader_lakehouse"
GOLD_SCHEMA="gold"

# The icmarkets instrument dimension, joined to symbols_category_icmarkets
# and asset_classes_icmarkets to resolve the asset class.
SYMBOL_TABLE="symbols_icmarkets"

# Cap on rows fetched per request.
MAX_TICKS="200000"

# Ticker pinned as the dashboard default (matched by symbolName, then id).
DEFAULT_SYMBOL="XAUUSD"

# --- Availability ---------------------------------------------------------
# Serve the branded "temporarily unavailable" page (app/static/unavailable.html)
# from / instead of the dashboard, with a 503, for a planned maintenance
# window. Leave it off in normal operation; the page is always previewable at
# /unavailable either way.
MAINTENANCE_MODE="false"
